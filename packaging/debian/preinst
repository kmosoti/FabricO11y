#!/bin/sh
# Refuse an existing fabricolly account or group that is not the expected
# non-login system service identity, before any file is unpacked.
set -e
if [ "$1" = install ] || [ "$1" = upgrade ]; then
  if entry=$(getent passwd fabricolly); then
    uid=$(echo "$entry" | cut -d: -f3)
    shell=$(echo "$entry" | cut -d: -f7)
    group=$(id -gn fabricolly)
    if [ "$uid" -eq 0 ] || [ "$uid" -ge 1000 ] || [ "$group" != fabricolly ] || [ "$shell" != /usr/sbin/nologin ]; then
      echo "fabrico11y: existing account fabricolly (uid $uid, group $group, shell $shell) is not the expected service identity; refusing to install" >&2
      exit 1
    fi
  fi
  if gentry=$(getent group fabricolly); then
    gid=$(echo "$gentry" | cut -d: -f3)
    if [ "$gid" -eq 0 ] || [ "$gid" -ge 1000 ]; then
      echo "fabrico11y: existing group fabricolly (gid $gid) is not a system group; refusing to install" >&2
      exit 1
    fi
  fi
fi
exit 0
