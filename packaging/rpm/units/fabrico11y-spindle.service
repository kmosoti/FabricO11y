[Unit]
Description=FabricO11y Spindle local observation custody
Documentation=https://github.com/kmosoti/FabricO11y
After=fabrico11y-server.service

[Service]
Type=notify
NotifyAccess=main
Slice=fabrico11y.slice
KillMode=control-group
EnvironmentFile=%h/.config/fabrico11y-rpm/environment
ExecStart=/usr/bin/spindle serve %h/.config/fabrico11y-rpm/spindle.json
ExecStop=/usr/bin/spindle stop %t/spindle/spindle.sock
RuntimeDirectory=spindle
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
SyslogIdentifier=spindle

[Install]
WantedBy=default.target
