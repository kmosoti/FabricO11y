# Fabric O11y node. Copy to /etc/fabrico11y/node.conf (root-owned, 0644).
spool_dir=/var/lib/fabrico11y/node/spool
metric_interval_s=15
spool_bytes=268435456
# This standalone edge service keeps its configured destination. Production
# fabric-node also collects spool_dir/diagnostics/spindle.log automatically;
# it counts against the 16-source bound and survives remote log replacement.
# Selected logs need a narrow read ACL for fabricolly, for example:
#   setfacl -m u:fabricolly:r /var/log/app.log
# log=/var/log/app.log
# Delivery target; all three together. The token file is 0640 root:fabricolly.
# server_url=https://fabric-server.example:7443
# server_ca=/etc/fabrico11y/ca.pem
# token_file=/etc/fabrico11y/node-token
# Loopback OTLP/HTTP endpoint for local applications' trace exports (ADR-0025),
# for example OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# with OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf. Loopback addresses only.
# traces_listen=127.0.0.1:4318
# Cap on delivered bytes per second (at least 65536); unset is uncapped.
# max_output_bytes_per_s=10485760
