[Unit]
Description=Fabric O11y services (aggregate resource bound)
Documentation=https://github.com/kmosoti/FabricO11y/blob/main/docs/architecture/deployment.md

[Slice]
MemoryAccounting=yes
TasksAccounting=yes
IOAccounting=yes
MemoryHigh=2816M
MemoryMax=3328M
TasksMax=640
CPUWeight=100
IOWeight=100
