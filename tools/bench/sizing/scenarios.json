  "scenarios": [
    {"name": "development", "nodes": 1, "events_per_second": 10, "retention_days": 1, "trial_vcpus": 2, "trial_ram_gib": 4},
    {"name": "small", "nodes": 20, "events_per_second": 1000, "retention_days": 7, "trial_vcpus": 2, "trial_ram_gib": 4},
    {"name": "moderate", "nodes": 200, "events_per_second": 10000, "retention_days": 14, "trial_vcpus": 4, "trial_ram_gib": 8},
    {"name": "enterprise", "nodes": 2000, "events_per_second": 100000, "retention_days": 30, "trial_vcpus": 16, "trial_ram_gib": 32}
  ]
}
