    "storage_ratios": [0.5, 1.6],
    "service_derating": 0.5,
    "network_margin": 1.2,
    "disk_margin": 1.25,
    "file_mib": 64,
    "journal_floor_gib": 20,
    "fixed_server_gib": 1,
    "builder_gib": 0.625,
    "builder_margin": 1.25,
    "host_reserve_gib": 1,
    "memory_target_fraction": 0.75
