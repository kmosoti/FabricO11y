{
  "description": "Load Fabric O11y context, validate documentation, and record passive local telemetry.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/run.py\"",
            "timeout": 5,
            "additionalContextLimit": 2000,
            "statusMessage": "Loading Fabric O11y current state"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/tools/telemetry/cli.py\" observe",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/run.py\"",
            "timeout": 30,
            "statusMessage": "Checking Fabric O11y documentation"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/tools/telemetry/cli.py\" observe",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/tools/telemetry/cli.py\" observe",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/tools/telemetry/cli.py\" observe",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/tools/telemetry/cli.py\" observe",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/tools/telemetry/cli.py\" observe",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/tools/telemetry/cli.py\" observe",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ]
  }
}
