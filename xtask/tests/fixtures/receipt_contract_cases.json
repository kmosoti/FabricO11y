{
  "schema_version": 1,
  "authority": "docs/formal/verification-receipt-contract.md",
  "expected_outcomes_are_independent_of_implementation": true,
  "retired_python_test_mapping": {
    "LiveCandidateTests.test_clean_live_candidate_identity_is_accepted": ["positive-fast", "positive-extended"],
    "LiveCandidateTests.test_input_changes_after_receipts_are_rejected": ["dirty-checkout"],
    "ReceiptTests.test_complete_evidence_is_accepted": ["positive-extended"],
    "ReceiptTests.test_missing_receipt_is_not_success": ["missing-receipt"],
    "ReceiptTests.test_missing_or_tampered_log_is_not_success": ["missing-log", "modified-log"],
    "ReceiptTests.test_failure_and_incomplete_cannot_be_relabelled_by_wrapper": ["wrong-result", "nonzero-exit", "nonzero-exit-three", "null-exit", "unavailable-result"],
    "ReceiptTests.test_stale_dirty_or_different_command_receipt_is_rejected": ["stale-commit", "dirty-flag", "wrong-command", "wrong-profile"],
    "ReceiptTests.test_running_marker_overrides_an_old_success": ["running-marker", "dangling-marker-symlink"],
    "ReceiptTests.test_invalid_or_duplicate_ids_and_empty_profile_are_refused": ["invalid-registry-command", "invalid-registry-id", "duplicate-registry-id", "empty-profile"],
    "ReceiptTests.test_symlinked_evidence_is_refused": ["symlink-receipt", "symlink-log"]
  },
  "cases": [
    {"id":"positive-fast","profile":"fast","mutation":"none","exit_code":0,"basis":"complete selected registry profile with clean current identity and matching ordinary logs is accepted"},
    {"id":"positive-extended","profile":"extended","mutation":"none","exit_code":0,"basis":"complete selected registry profile with clean current identity and matching ordinary logs is accepted"},
    {"id":"descriptive-extra-field","profile":"extended","mutation":"include-unknown-descriptive-receipt-fields","exit_code":0,"basis":"unknown descriptive receipt fields remain allowed when required fields are valid"},
    {"id":"dirty-checkout","profile":"extended","mutation":"run-cli-against-dirty-git-worktree","exit_code":1,"basis":"final verification requires the actual checkout to be clean"},
    {"id":"missing-receipt","profile":"extended","mutation":"remove-selected-receipt","exit_code":1,"basis":"every selected check requires a receipt"},
    {"id":"missing-log","profile":"extended","mutation":"remove-selected-log","exit_code":1,"basis":"every receipt requires its matching output log"},
    {"id":"symlink-receipt","profile":"extended","mutation":"replace-receipt-with-symlink","exit_code":1,"basis":"receipt leaves must be ordinary files opened without following links"},
    {"id":"symlink-log","profile":"extended","mutation":"replace-log-with-symlink","exit_code":1,"basis":"log leaves must be ordinary files opened without following links"},
    {"id":"running-marker","profile":"extended","mutation":"create-current-check-entry","exit_code":1,"basis":"any interrupted or running check marker prevents a complete-profile pass"},
    {"id":"dangling-marker-symlink","profile":"extended","mutation":"create-dangling-current-check-symlink","exit_code":1,"basis":"any current-check directory entry prevents success, including a dangling symlink"},
    {"id":"stale-commit","profile":"extended","mutation":"change-candidate-commit","exit_code":1,"basis":"receipt candidate identity must equal the checked-out commit"},
    {"id":"dirty-flag","profile":"extended","mutation":"set-worktree-dirty-true","exit_code":1,"basis":"a receipt marked dirty cannot establish current clean-source evidence"},
    {"id":"wrong-command","profile":"extended","mutation":"change-command-argument","exit_code":1,"basis":"receipt command must equal the registered command"},
    {"id":"wrong-id","profile":"extended","mutation":"change-check-id","exit_code":1,"basis":"receipt identifier must equal its selected registry entry"},
    {"id":"wrong-profile","profile":"extended","mutation":"change-receipt-profile","exit_code":1,"basis":"receipt profile must equal the selected profile"},
    {"id":"wrong-result","profile":"extended","mutation":"set-result-failed","exit_code":1,"basis":"only passed check receipts are accepted"},
    {"id":"wrong-log-name","profile":"extended","mutation":"change-output-log-name","exit_code":1,"basis":"receipt log name is the canonical check-id leaf"},
    {"id":"wrong-version","profile":"extended","mutation":"set-receipt-version-two","exit_code":1,"basis":"only receipt version one is accepted"},
    {"id":"nonzero-exit","profile":"extended","mutation":"set-exit-code-one","exit_code":1,"basis":"successful evidence requires exact integer exit code zero"},
    {"id":"nonzero-exit-three","profile":"extended","mutation":"set-exit-code-three","exit_code":1,"basis":"incomplete code three cannot be reclassified as a complete pass"},
    {"id":"unavailable-result","profile":"extended","mutation":"set-result-environment-unavailable-with-null-exit","exit_code":1,"basis":"unavailable evidence is not a successful receipt"},
    {"id":"null-exit","profile":"extended","mutation":"set-exit-code-null","exit_code":1,"basis":"successful evidence requires exact integer exit code zero"},
    {"id":"boolean-exit","profile":"extended","mutation":"set-exit-code-false","exit_code":1,"basis":"JSON booleans are not integer exit statuses"},
    {"id":"float-exit","profile":"extended","mutation":"set-exit-code-zero-float","exit_code":1,"basis":"JSON floating-point values are not integer exit statuses"},
    {"id":"negative-duration","profile":"extended","mutation":"set-duration-minus-one","exit_code":1,"basis":"duration must be a nonnegative integer"},
    {"id":"boolean-duration","profile":"extended","mutation":"set-duration-true","exit_code":1,"basis":"JSON booleans are not integer durations"},
    {"id":"float-duration","profile":"extended","mutation":"set-duration-fraction","exit_code":1,"basis":"JSON floating-point values are not integer durations"},
    {"id":"modified-log","profile":"extended","mutation":"change-log-bytes-without-updating-digest","exit_code":1,"basis":"actual output-log bytes must match the receipt digest"},
    {"id":"duplicate-result-key","profile":"extended","mutation":"duplicate-result-failed-then-passed","exit_code":1,"basis":"JSON object keys are unique under the accepted representation policy","policy_difference_from_legacy_python":true},
    {"id":"boolean-version","profile":"extended","mutation":"set-receipt-version-true","exit_code":1,"basis":"receipt version is the JSON integer one","policy_difference_from_legacy_python":true},
    {"id":"float-version","profile":"extended","mutation":"set-receipt-version-one-float","exit_code":1,"basis":"receipt version is the JSON integer one","policy_difference_from_legacy_python":true},
    {"id":"numeric-dirty-alias","profile":"extended","mutation":"set-worktree-dirty-zero","exit_code":1,"basis":"worktree_dirty is the JSON boolean false","policy_difference_from_legacy_python":true},
    {"id":"nonregular-receipt","profile":"extended","mutation":"replace-receipt-with-directory","exit_code":1,"basis":"receipt leaves must be ordinary files"},
    {"id":"nonregular-log","profile":"extended","mutation":"replace-log-with-directory","exit_code":1,"basis":"log leaves must be ordinary files"},
    {"id":"oversized-receipt","profile":"extended","mutation":"exceed-per-file-json-bound","exit_code":1,"basis":"receipt parsing uses the registered bounded artifact reader"},
    {"id":"aggregate-budget","profile":"fast","mutation":"pad-twenty-valid-receipts-past-64mib-json-budget","exit_code":1,"basis":"aggregate retained JSON budget fails closed; twenty individually bounded fast receipts can exceed the 64 MiB aggregate cap"},
    {"id":"duration-sum-overflow","profile":"fast","mutation":"set-durations-to-u64-max-and-one","exit_code":1,"basis":"total duration arithmetic fails closed on overflow"},
    {"id":"invalid-registry-command","profile":"extended","mutation":"set-command-argument-to-number-in-source-fixture","exit_code":1,"basis":"registry commands contain only string arguments"},
    {"id":"invalid-registry-id","profile":"extended","mutation":"set-id-to-noncanonical-path","exit_code":1,"basis":"registry check IDs use the bounded lowercase identifier grammar"},
    {"id":"duplicate-registry-id","profile":"extended","mutation":"duplicate-selected-registry-id-in-source-fixture","exit_code":1,"basis":"registry check IDs are unique"},
    {"id":"empty-profile","profile":"extended","mutation":"select-supported-profile-with-no-checks-in-source-fixture","exit_code":1,"basis":"a supported selected profile must contain at least one registered check"}
  ]
}
