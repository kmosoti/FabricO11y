{
  "version": 1,
  "description": "Hand-written semantic mutants, each tied to a verification-matrix contract. Run with `cargo xtask mutants`; every mutant must be caught by its named test. Changing an entry's expected checker is a trust-boundary change.",
  "mutants": [
    {
      "id": "M-DEL-ACK",
      "contract": "DEL-1 commit precedes ACK",
      "incorrect_behavior": "ACK the group even when the durable append failed",
      "file": "crates/fabric-app/src/delivery.rs",
      "find": "journal.commit(&accepted, received).is_ok()",
      "replace": "{ let _ = journal.commit(&accepted, received); true }",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-core",
        "-p",
        "fabric-app"
      ],
      "expect_failing": "ack_is_returned_only_after_a_successful_commit"
    },
    {
      "id": "M-DEL-BYTES",
      "contract": "DEL-3 same Strand and sequence with different bytes is rejected",
      "incorrect_behavior": "accept a same-sequence retry whose bytes differ as a duplicate",
      "file": "crates/fabric-core/src/delivery.rs",
      "find": "Some(c) if c.digest == incoming.digest =>",
      "replace": "Some(_) =>",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-core",
        "-p",
        "fabric-app"
      ],
      "expect_failing": "adr_0013_truth_table"
    },
    {
      "id": "M-DEL-GAP",
      "contract": "DEL-4 a sequence gap is detected",
      "incorrect_behavior": "commit any sequence above the last one, hiding the gap",
      "file": "crates/fabric-core/src/delivery.rs",
      "find": "if next_sequence(last) == Some(sequence) {",
      "replace": "if sequence > last {",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-core",
        "-p",
        "fabric-app"
      ],
      "expect_failing": "adr_0013_truth_table"
    },
    {
      "id": "M-DEL-BIND",
      "contract": "DEL-5 credential and Spindle binding cannot silently change",
      "incorrect_behavior": "drop the binding check",
      "file": "crates/fabric-core/src/delivery.rs",
      "find": "    if !binding.permits(incoming.strand.spindle()) {",
      "replace": "    if false && !binding.permits(incoming.strand.spindle()) {",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-core",
        "-p",
        "fabric-app"
      ],
      "expect_failing": "binding_disagreement_in_either_direction_forbids_before_sequencing"
    },
    {
      "id": "M-DEL-GROUP",
      "contract": "DEL-5 binding holds within one commit group",
      "incorrect_behavior": "ignore bindings staged earlier in the same group",
      "file": "crates/fabric-core/src/delivery.rs",
      "find": "                    .any(|(c, s)| *c != credential && *s == spindle),",
      "replace": "                    .any(|(c, s)| *c != credential && *s == spindle && false),",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-app"
      ],
      "expect_failing": "extraction_agrees_with_the_base_decision_loop_on_every_small_group"
    },
    {
      "id": "M-SPOOL-RECLAIM",
      "contract": "SPOOL-2 reclaim removes only acknowledged closed files",
      "incorrect_behavior": "delete a sealed file that still holds the first unacknowledged Batch",
      "file": "src/spindle/spool.rs",
      "find": "if successor > through + 1 {",
      "replace": "if successor > through + 2 {",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric_o11y",
        "--lib"
      ],
      "expect_failing": "reclaim_keeps_the_file_holding_the_first_unacknowledged_batch"
    },
    {
      "id": "M-SPOOL-KNOWN",
      "contract": "SPOOL-3 interrupted-append recovery does not clear a known I/O failure",
      "incorrect_behavior": "reopen a journal whose writer reported a sync error",
      "file": "crates/fabric-frame/src/frame.rs",
      "find": "        if dir.join(RECOVERY_REQUIRED).exists() {",
      "replace": "        if false && dir.join(RECOVERY_REQUIRED).exists() {",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric_o11y",
        "--lib"
      ],
      "expect_failing": "reported_sync_errors_quarantine_and_record_known_failure"
    },
    {
      "id": "M-CTRL-REVOKE",
      "contract": "CTRL-2 a revoked identity cannot continue sending",
      "incorrect_behavior": "keep a revoked credential's token authorized",
      "file": "crates/fabric-core/src/control.rs",
      "find": "    !matches!(status, Status::Revoked)\n",
      "replace": "    true\n",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-server",
        "--test",
        "control"
      ],
      "expect_failing": "admin_api_configures_pauses_and_revokes_a_polling_node"
    },
    {
      "id": "M-CTRL-INVALID",
      "contract": "CTRL-1 an invalid desired configuration does not become active",
      "incorrect_behavior": "activate a remote configuration that fails local validation",
      "file": "src/spindle/runtime.rs",
      "find": "    config.interval_s = view.metric_interval_s;\n    config.validate()?;",
      "replace": "    config.interval_s = view.metric_interval_s;\n    let _ = config.validate();",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-server",
        "--test",
        "control"
      ],
      "expect_failing": "admin_api_configures_pauses_and_revokes_a_polling_node"
    },
    {
      "id": "M-HIST-CORRUPT",
      "contract": "HIST-3 a missing or corrupt Segment never yields a complete answer",
      "incorrect_behavior": "report a query complete although a Segment could not be read",
      "file": "crates/fabric-core/src/query.rs",
      "find": "    unavailable == 0\n",
      "replace": "    true\n",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-server",
        "--test",
        "history"
      ],
      "expect_failing": "a_corrupt_segment_makes_the_answer_incomplete"
    },
    {
      "id": "M-HIST-GONE",
      "contract": "HIST-5 a page whose snapshot is no longer retained answers Gone",
      "incorrect_behavior": "serve a later page after retention removed part of its snapshot",
      "file": "crates/fabric-core/src/query.rs",
      "find": "    oldest_retained <= page_floor\n",
      "replace": "    true\n",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-server",
        "--test",
        "history"
      ],
      "expect_failing": "retention_removes_old_segments_and_stream_state_survives_it"
    },
    {
      "id": "M-HIST-RESET",
      "contract": "HIST-6 counter resets produce reset markers, not rates",
      "incorrect_behavior": "compute a rate across a counter reset",
      "file": "crates/fabric-core/src/query.rs",
      "find": "    if previous.start_ns == next.start_ns\n        && next.value >= previous.value\n        && next.time_ns > previous.time_ns\n",
      "replace": "    if next.time_ns > previous.time_ns\n",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-server",
        "--test",
        "history"
      ],
      "expect_failing": "sealed_history_answers_exactly_and_pages_are_stable"
    },
    {
      "id": "M-HIST-SEGMENT",
      "contract": "HIST-1 journal and Segment representations answer identically",
      "incorrect_behavior": "drop log attributes when rows are read back from a Segment",
      "file": "crates/fabric-server/src/segment.rs",
      "find": "attributes: attrs_of(a.value(row))?,",
      "replace": "attributes: Default::default(),",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-server",
        "--test",
        "history"
      ],
      "expect_failing": "journal_and_segment_representations_answer_identically"
    },
    {
      "id": "M-CTRL-TERMINAL",
      "contract": "CTRL-2 revocation is terminal",
      "incorrect_behavior": "let a revoked enrollment be paused or resumed",
      "file": "crates/fabric-core/src/control.rs",
      "find": "        Status::Revoked => Err(ControlRejection::Revoked),\n        _ => Ok(target),",
      "replace": "        _ => Ok(target),",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-core"
      ],
      "expect_failing": "revocation_is_terminal_for_every_request"
    },
    {
      "id": "M-RET-AGE",
      "contract": "HIST-5 retention deletes only Segments older than the age limit",
      "incorrect_behavior": "delete a Segment whose newest record is exactly at the cutoff",
      "file": "crates/fabric-core/src/retention.rs",
      "find": "if segment.received_max_ns >= cutoff && total <= max_bytes {",
      "replace": "if segment.received_max_ns > cutoff && total <= max_bytes {",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-core",
        "--test",
        "legacy_kernels"
      ],
      "expect_failing": "retention_matches_the_base_on_every_small_history"
    },
    {
      "id": "M-COL-RESET",
      "contract": "SPOOL-1 fidelity: a counter decrease starts a new series",
      "incorrect_behavior": "keep the old start time after a counter decrease",
      "file": "crates/fabric-core/src/collection.rs",
      "find": "        Some(_) => now_ns,",
      "replace": "        Some((_, prior_start)) => prior_start,",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric_o11y",
        "--test",
        "spindle"
      ],
      "expect_failing": "counters_preserve_start_then_reset_on_decrease_and_boot_change"
    },
    {
      "id": "M-COL-CURSOR",
      "contract": "SPOOL-1 a cursor without a witness never skips a recreated file",
      "incorrect_behavior": "continue an unwitnessed cursor at a non-zero offset",
      "file": "crates/fabric-core/src/collection.rs",
      "find": "    if old.offset > 0 && old.prefix_len == 0 {",
      "replace": "    if false && old.offset > 0 && old.prefix_len == 0 {",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-core",
        "--test",
        "legacy_kernels"
      ],
      "expect_failing": "cursor_checks_match_the_base_for_every_small_case"
    },
    {
      "id": "M-PROP-GROUP",
      "contract": "DEL-5 bindings made earlier in a commit group bind later Batches of the same group",
      "incorrect_behavior": "ignore a Spindle bound to another credential earlier in the same group",
      "file": "crates/fabric-core/src/delivery.rs",
      "find": ".any(|(c, s)| *c != credential && *s == spindle)",
      "replace": ".any(|(c, s)| false && *c != credential && *s == spindle)",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-properties"
      ],
      "expect_failing": "a_commit_group_decides_like_one_batch_at_a_time"
    },
    {
      "id": "M-PROP-PAGE",
      "contract": "HIST-4 pages never repeat or skip a row within one snapshot",
      "incorrect_behavior": "continue a page at its last key instead of strictly after it",
      "file": "crates/fabric-core/src/query.rs",
      "find": "after.is_none_or(|a| key > a)",
      "replace": "after.is_none_or(|a| key >= a)",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-properties"
      ],
      "expect_failing": "pages_cover_every_row_once_in_order"
    },
    {
      "id": "M-PROP-TEXT",
      "contract": "SPOOL-1 gap texts stay within their byte bound",
      "incorrect_behavior": "allow one byte more than the cap",
      "file": "crates/fabric-core/src/collection.rs",
      "find": "let mut end = message.len().min(cap);",
      "replace": "let mut end = message.len().min(cap.saturating_add(1));",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-properties"
      ],
      "expect_failing": "bounded_text_is_the_longest_valid_prefix_within_the_cap"
    },
    {
      "id": "M-PROP-RET-BYTES",
      "contract": "HIST-5 retention deletes only what the limits require",
      "incorrect_behavior": "treat a total exactly at the byte limit as over it",
      "file": "crates/fabric-core/src/retention.rs",
      "find": "total <= max_bytes",
      "replace": "total < max_bytes",
      "command": [
        "cargo",
        "test",
        "--no-fail-fast",
        "--locked",
        "-p",
        "fabric-properties"
      ],
      "expect_failing": "retention_deletes_the_shortest_sufficient_oldest_prefix"
    },
    {
      "id": "M-KANI-SEQ",
      "contract": "DEL-4 no sequence follows u64::MAX on a Strand",
      "incorrect_behavior": "wrap the successor of u64::MAX to 0",
      "file": "crates/fabric-core/src/strand.rs",
      "find": "last.checked_add(1)",
      "replace": "Some(last.wrapping_add(1))",
      "command": [
        "bash",
        "formal/kani/check.sh"
      ],
      "expect_failing": "proofs::next_sequence_is_one_more_or_none_at_the_end"
    },
    {
      "id": "M-KANI-DUP",
      "contract": "DEL-3 same Strand and sequence with different bytes is rejected",
      "incorrect_behavior": "treat any retry of the last sequence as a duplicate",
      "file": "crates/fabric-core/src/delivery.rs",
      "find": "Some(c) if c.digest == incoming.digest =>",
      "replace": "Some(c) if true || c.digest == incoming.digest =>",
      "command": [
        "bash",
        "formal/kani/check.sh"
      ],
      "expect_failing": "proofs::delivery_decisions_follow_the_table"
    },
    {
      "id": "M-KANI-RET-SATURATE",
      "contract": "HIST-5 retention deletes until the remaining Segments fit the byte limit",
      "incorrect_behavior": "reintroduce the saturating total (CX-RETENTION-SATURATED-TOTAL)",
      "file": "crates/fabric-core/src/retention.rs",
      "find": "let mut total: u128 = segments.iter().map(|s| u128::from(s.bytes)).sum();",
      "replace": "let mut total: u128 = u128::from(segments.iter().fold(0_u64, |a, s| a.saturating_add(s.bytes)));",
      "command": [
        "bash",
        "formal/kani/check.sh"
      ],
      "expect_failing": "proofs::retention_deletes_the_shortest_sufficient_prefix"
    }
  ]
}
