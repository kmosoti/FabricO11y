{
  "version": 1,
  "description": "Fixture copy of the repository purity policy with fx-core as the core and one allowed pure dependency.",
  "core_crates": [
    "fx-core"
  ],
  "allowed_dependencies": {
    "libm": "fixture: an allowed pure numeric crate"
  },
  "allowed_dev_dependencies": {},
  "allowed_features": [],
  "denied": {
    "async-runtime": [
      "tokio",
      "async-std",
      "smol",
      "futures",
      "futures-executor",
      "mio"
    ],
    "http-server": [
      "axum",
      "axum-server",
      "hyper",
      "warp",
      "actix-web",
      "tower",
      "tower-http"
    ],
    "http-client": [
      "ureq",
      "reqwest",
      "isahc",
      "curl",
      "attohttpc"
    ],
    "tls": [
      "rustls",
      "openssl",
      "native-tls",
      "tokio-rustls",
      "ring",
      "aws-lc-rs"
    ],
    "network": [
      "socket2",
      "tonic",
      "h2",
      "http"
    ],
    "filesystem": [
      "tempfile",
      "walkdir",
      "notify",
      "fs-err",
      "fs2",
      "fs4",
      "memmap2",
      "glob"
    ],
    "columnar-storage": [
      "parquet",
      "arrow",
      "arrow-array",
      "arrow-schema",
      "rusqlite",
      "sled",
      "rocksdb"
    ],
    "randomness": [
      "rand",
      "rand_core",
      "rand_chacha",
      "getrandom",
      "fastrand",
      "uuid",
      "fake"
    ],
    "ambient-clock": [
      "chrono",
      "time",
      "jiff",
      "coarsetime",
      "quanta"
    ],
    "os-process": [
      "libc",
      "nix",
      "rustix",
      "sysinfo",
      "procfs",
      "duct",
      "signal-hook",
      "ctrlc"
    ],
    "systemd": [
      "sd-notify",
      "libsystemd",
      "systemd",
      "systemd-journal-logger"
    ],
    "logging-runtime": [
      "tracing-subscriber",
      "env_logger",
      "log4rs"
    ]
  },
  "required_attributes": [
    "#![no_std]",
    "#![forbid(unsafe_code)]"
  ],
  "forbidden_source_patterns": {
    "extern crate std": "re-enables the standard library, and with it ambient effects, inside a no_std crate",
    "static mut": "global mutable state",
    "thread_local!": "hidden per-thread state",
    "AtomicU": "a static atomic is hidden global mutable state; pass state explicitly",
    "AtomicI": "a static atomic is hidden global mutable state; pass state explicitly",
    "AtomicBool": "a static atomic is hidden global mutable state; pass state explicitly"
  }
}
