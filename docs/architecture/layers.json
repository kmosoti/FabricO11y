{
  "version": 1,
  "description": "Hexagonal dependency rule checked by `cargo xtask check-layers`. See ../decisions/ADR-0015-adopt-a-hexagonal-architecture.md.",
  "layers": {
    "core": { "may_depend_on": ["core"] },
    "ports": { "may_depend_on": ["core"] },
    "app": { "may_depend_on": ["core", "ports"] },
    "adapter-support": { "may_depend_on": ["core"] },
    "adapter": { "may_depend_on": ["core", "ports", "adapter-support"] },
    "composition-root": { "may_depend_on": ["core", "ports", "app", "adapter-support", "adapter"] },
    "verification": { "may_depend_on": ["core", "ports", "app", "adapter-support", "adapter", "composition-root", "verification"] },
    "tooling": { "may_depend_on": [] }
  },
  "crates": {
    "fabric-core": "core",
    "fabric-ports": "ports",
    "fabric-app": "app",
    "fabric-frame": "adapter-support",
    "fabric-adapter-linux": "adapter",
    "fabric_o11y": "composition-root",
    "fabric-server": "composition-root",
    "xtask": "tooling",
    "fabric-properties": "verification",
    "fabric-fuzz-targets": "verification",
    "fabric-sim": "verification"
  },
  "exceptions": [
    {
      "from": "fabric-server",
      "to": "fabric_o11y",
      "kinds": ["dev"],
      "reason": "End-to-end tests in crates/fabric-server/tests run a real Spindle (the root package) against a real server. Test-only; the server library and binary do not link the Spindle."
    }
  ]
}
