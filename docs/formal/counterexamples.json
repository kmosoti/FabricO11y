  "counterexamples": [
    {
      "id": "CX-SPOOL-LENGTH",
      "origin": "review of the Spool journal (see docs/experiments/formal/alpha-journal-length-repair.md)",
      "defect": "A corrupted frame length made reopen truncate two committed Batches",
      "seed_or_trace": "frozen byte-level corruption in the record",
      "contract": "SPOOL-3",
      "reproducer": {
        "file": "tests/spool.rs",
        "test": "changed_length_cannot_erase_two_committed_batches_on_reopen"
      },
      "fix_commit": "af5b7bc"
    },
    {
      "id": "CX-GAP-UNICODE",
      "origin": "review checkpoint (docs/experiments/formal/alpha-phase1-review-checkpoint.md)",
      "defect": "A multibyte path in a gap text exceeded the byte cap",
      "seed_or_trace": "checkpoint-review.json counterexample",
      "contract": "SPOOL-1",
      "reproducer": {
        "file": "tests/spindle.rs",
        "test": "multibyte_missing_log_path_commits_a_byte_bounded_gap"
      },
      "fix_commit": "fcdc12f"
    },
    {
      "id": "CX-INTERRUPTED-APPEND",
      "origin": "design decision D1 (ADR-0011)",
