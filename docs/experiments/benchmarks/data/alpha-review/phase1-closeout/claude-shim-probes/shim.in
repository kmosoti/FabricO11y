#define _GNU_SOURCE
#include <dlfcn.h>
#include <errno.h>
#include <fcntl.h>
#include <signal.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/syscall.h>
#include <sys/types.h>
#include <sys/uio.h>
#include <unistd.h>

static long counter = 0;
static int inited = 0;
static const char *prefix, *mode, *kind, *match; static long at = -1; static int trace = 0;
static void init(void) { if (inited) return; inited = 1;
  prefix = getenv(@@SHIM_PREFIX@@); mode = getenv(@@SHIM_MODE@@); kind = getenv(@@SHIM_KIND@@); match = getenv(@@SHIM_MATCH@@);
  const char *a = getenv(@@SHIM_AT@@); if (a) at = atol(a); trace = getenv(@@SHIM_TRACE@@) != NULL; }
static int fdpath(int fd, char *buf, size_t n) { char p[64]; snprintf(p, sizeof p, @@%cproc%cself%cfd%c%d@@, 47, 47, 47, 47, fd);
  ssize_t r = readlink(p, buf, n - 1); if (r < 0) { buf[0] = 0; return -1; } buf[r] = 0; return 0; }
static void die(void) { kill(getpid(), SIGKILL); }
static int event(const char *k, const char *path) {
  init(); if (!prefix || !path || strncmp(path, prefix, strlen(prefix)) != 0) return 0;
  if (kind && strcmp(kind, k) != 0) return 0;
  if (match && !strstr(path, match)) return 0;
  counter++;
  if (trace) { char b[600]; int n = snprintf(b, sizeof b, @@SHIM %ld %s %s\n@@, counter, k, path); syscall(SYS_write, 2, b, n); }
  if (counter != at || !mode) return 0;
  if (!strcmp(mode, @@kill_before@@)) die();
  if (!strcmp(mode, @@eio@@)) return 1;
  if (!strcmp(mode, @@kill_after@@)) return 2;
  return 0; }
#define REAL(ret, name, ...) static ret (*real_##name)(__VA_ARGS__); if (!real_##name) real_##name = dlsym(RTLD_NEXT, #name);
ssize_t write(int fd, const void *b, size_t n) { REAL(ssize_t, write, int, const void*, size_t)
  char p[512]; fdpath(fd, p, sizeof p); int e = event(@@write@@, p); if (e == 1) { errno = EIO; return -1; }
  ssize_t r = real_write(fd, b, n); if (e == 2) die(); return r; }
ssize_t writev(int fd, const struct iovec *v, int c) { REAL(ssize_t, writev, int, const struct iovec*, int)
  char p[512]; fdpath(fd, p, sizeof p); int e = event(@@write@@, p); if (e == 1) { errno = EIO; return -1; }
  ssize_t r = real_writev(fd, v, c); if (e == 2) die(); return r; }
int fsync(int fd) { REAL(int, fsync, int) char p[512]; fdpath(fd, p, sizeof p); int e = event(@@fsync@@, p);
  if (e == 1) { errno = EIO; return -1; } int r = real_fsync(fd); if (e == 2) die(); return r; }
int unlink(const char *path) { REAL(int, unlink, const char*) int e = event(@@unlink@@, path);
  if (e == 1) { errno = EIO; return -1; } int r = real_unlink(path); if (e == 2) die(); return r; }
int rename(const char *a, const char *b) { REAL(int, rename, const char*, const char*) int e = event(@@rename@@, b);
  if (e == 1) { errno = EIO; return -1; } int r = real_rename(a, b); if (e == 2) die(); return r; }
int ftruncate64(int fd, off_t l) { REAL(int, ftruncate64, int, off_t) char p[512]; fdpath(fd, p, sizeof p); int e = event(@@ftruncate@@, p);
  if (e == 1) { errno = EIO; return -1; } int r = real_ftruncate64(fd, l); if (e == 2) die(); return r; }
int open64(const char *path, int flags, ...) { REAL(int, open64, const char*, int, ...) mode_t m = 0;
  if (flags & (O_CREAT | O_TMPFILE)) { va_list ap; va_start(ap, flags); m = va_arg(ap, int); va_end(ap); }
  int e = event((flags & O_CREAT) ? @@create@@ : @@open@@, path); if (e == 1) { errno = EIO; return -1; }
  int r = real_open64(path, flags, m); if (e == 2) die(); return r; }
